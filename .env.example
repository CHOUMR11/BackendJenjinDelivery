# Copier en .env et adapter avant la mise en production.
# Ce fichier n'est PAS lu automatiquement par Spring Boot seul :
# exporter ces variables dans l'environnement (ou via docker-compose / systemd) avant de lancer l'app.

JWT_SECRET=change_me_with_a_real_random_secret_at_least_32_chars
JWT_EXPIRATION_MS=86400000

ADMIN_BOOTSTRAP_TELEPHONE=20000000
ADMIN_BOOTSTRAP_PASSWORD=change_me_before_first_deploy

DB_URL=jdbc:postgresql://localhost:5432/jenjon_delivery
DB_USERNAME=jenjon
DB_PASSWORD=jenjon

CORS_ALLOWED_ORIGINS=https://admin.jenjondelivery.tn,https://app.jenjondelivery.tn

NOTIF_EMAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
NOTIF_EMAIL_FROM=no-reply@jenjondelivery.tn

NOTIF_SMS_ENABLED=false
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_URL=

NOTIF_PUSH_ENABLED=false
FCM_CREDENTIALS_PATH=
